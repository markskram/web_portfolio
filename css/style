#hero-banner {
  background-color: red;
  background-image: url("images/hero-banner.png");
  background-size: cover;
  background-position: center;
  height: 300px;
  display: flex;
  align-items: center;
  justify-content: center;
}

#hero-banner h1 {
  color: #ffffff;
  font-size: 38px;
  text-shadow: 0 2px 6px rgba(0,0,0,0.7);
  margin: 0;
}

.second-headline {
  color: blueviolet;
  font-size: 29px;
}

.text {
  color: #333333;
}

#hero-bottom-banner {
  width: 100%;
  height: auto;
  display: block;
}

.btn-kontakt {
  display: inline-block;
  padding: 10px 24px;
  background-color: #2a3f8f;
  color: #ffffff;
  text-decoration: none;
  border-radius: 6px;
}
